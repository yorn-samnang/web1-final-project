  "type": "module",
  "bugs": {
    "url": "https://github.com/yorn-samnang/web1-final-project/issues"
  },
  "homepage": "https://github.com/yorn-samnang/web1-final-project#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.8"
  }
}
