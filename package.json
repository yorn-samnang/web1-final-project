{
  "name": "web1-final-project",
  "version": "1.0.0",
  "description": "Kamsan is a Web Development II travel-planning application for tourists exploring Cambodia.",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint \"js/**/*.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorn-samnang/web1-final-project.git"
  },
  "keywords": [],
